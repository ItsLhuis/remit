{
  "name": "remit",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@10.33.4",
  "type": "module",
  "description": "Open-source, self-hostable business management platform for independent freelancers",
  "homepage": "https://github.com/ItsLhuis/remit#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ItsLhuis/remit.git"
  },
  "bugs": {
    "url": "https://github.com/ItsLhuis/remit/issues"
  },
  "license": "MIT",
  "author": "ItsLhuis",
  "keywords": [
    "business-management",
    "freelancers",
    "invoicing",
    "self-hosted",
    "nextjs",
    "react",
    "typescript",
    "postgresql",
    "drizzle",
    "better-auth"
  ],
  "scripts": {
    "prepare": "husky",
    "dev": "next dev --turbopack",
    "build": "next build && pnpm build:scripts",
    "build:scripts": "tsup --config tsup.scripts.config.ts",
    "start": "next start",
    "check": "pnpm lint && pnpm typecheck && pnpm test",
    "ci": "pnpm lint && pnpm typecheck && pnpm test && pnpm build",
    "dev:setup": "pnpm services:up && pnpm database:migrate",
    "services:up": "docker compose -f docker-compose.dev.yml up -d",
    "services:down": "docker compose -f docker-compose.dev.yml down",
    "services:logs": "docker compose -f docker-compose.dev.yml logs -f",
    "services:restart": "docker compose -f docker-compose.dev.yml restart",
    "lint": "pnpm lint:cycles && eslint . --cache --cache-location node_modules/.cache/eslint/",
    "lint:cycles": "oxlint",
    "lint:fix": "pnpm lint:cycles && eslint . --fix --cache --cache-location node_modules/.cache/eslint/",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "database:generate": "drizzle-kit generate",
    "database:migrate": "drizzle-kit migrate",
    "database:studio": "drizzle-kit studio",
    "database:test:up": "docker compose -f docker-compose.test.yml up -d",
    "database:test:down": "docker compose -f docker-compose.test.yml down -v",
    "database:test:migrate": "drizzle-kit migrate --config drizzle.test.config.ts",
    "remit:backup": "node ./scripts/dist/backup.js",
    "remit:reset-password": "node ./scripts/dist/reset-password.js",
    "remit:restore": "node ./scripts/dist/restore.js",
    "remit:rotate-encryption-key": "node ./scripts/dist/rotate-encryption-key.js",
    "remit:seed-demo": "node ./scripts/dist/seed-demo.js",
    "version:patch": "tsx ./scripts/bump-version.ts patch",
    "version:minor": "tsx ./scripts/bump-version.ts minor",
    "version:major": "tsx ./scripts/bump-version.ts major"
  },
  "engines": {
    "node": ">=24.11.1 <25",
    "pnpm": ">=10.33.4 <11"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": ">=24.11.1 <25",
      "onFail": "error"
    },
    "packageManager": {
      "name": "pnpm",
      "version": "10.33.4",
      "onFail": "error"
    }
  },
  "pnpm": {
    "overrides": {
      "eslint-config-next": "16.1.6",
      "next": "16.2.6",
      "semver": "^7.7.2"
    },
    "peerDependencyRules": {
      "allowedVersions": {
        "react": "19",
        "react-dom": "19"
      }
    }
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1030.0",
    "@aws-sdk/s3-request-presigner": "^3.1030.0",
    "@clack/prompts": "^1.3.0",
    "@dnd-kit/abstract": "^0.5.0",
    "@dnd-kit/dom": "^0.5.0",
    "@dnd-kit/react": "^0.5.0",
    "@hookform/resolvers": "^5.2.2",
    "@next/env": "16.2.6",
    "@tanstack/react-hotkeys": "^0.9.1",
    "@tanstack/react-table": "^8.21.3",
    "better-auth": "^1.6.23",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "country-data-list": "^1.6.0",
    "drizzle-orm": "^0.45.1",
    "i18next": "^26.0.8",
    "i18next-icu": "^2.4.3",
    "input-otp": "^1.4.2",
    "lucide-react": "^0.577.0",
    "motion": "^12.38.0",
    "next": "16.2.6",
    "next-themes": "^0.4.6",
    "nodemailer": "^8.0.9",
    "nuqs": "^2.8.9",
    "pino": "^10.3.1",
    "postgres": "^3.4.8",
    "qrcode.react": "^4.2.0",
    "radix-ui": "^1.4.3",
    "react": "^19.2.4",
    "react-circle-flags": "^0.0.27",
    "react-day-picker": "^9.14.0",
    "react-dom": "^19.2.4",
    "react-hook-form": "^7.72.0",
    "react-i18next": "^17.0.6",
    "react-phone-number-input": "^3.4.16",
    "recharts": "3.8.0",
    "resend": "^6.12.4",
    "sanitize-html": "^2.17.5",
    "shadcn": "^4.13.0",
    "sonner": "^2.0.7",
    "stripe": "^22.2.0",
    "tailwind-merge": "^3.5.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@commitlint/cli": "^20.4.3",
    "@commitlint/config-conventional": "^20.4.3",
    "@faker-js/faker": "^10.4.0",
    "@playwright/test": "^1.59.1",
    "@tailwindcss/postcss": "^4.1.18",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^24.11.1",
    "@types/nodemailer": "^8.0.0",
    "@types/react": "^19.2.10",
    "@types/react-dom": "^19.2.3",
    "@types/sanitize-html": "^2.16.1",
    "@vitest/coverage-v8": "^4.1.5",
    "chalk": "^5.6.2",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9.39.2",
    "eslint-config-next": "16.1.6",
    "eslint-plugin-i18next": "^6.1.4",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-perfectionist": "^5.9.1",
    "eslint-plugin-sonarjs": "^4.0.3",
    "happy-dom": "^20.9.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.2.7",
    "oxlint": "^1.75.0",
    "pino-pretty": "^13.1.3",
    "postcss": "^8",
    "prettier": "^3.8.1",
    "prettier-plugin-tailwindcss": "^0.7.2",
    "tailwindcss": "^4.1.18",
    "tsup": "^8.5.1",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.57.0",
    "vitest": "^4.1.5",
    "vitest-axe": "^0.1.0"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx,mjs,cjs}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,css,md,yaml,yml}": [
      "prettier --write"
    ]
  }
}
