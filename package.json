{
  "name": "remit",
  "private": true,
  "packageManager": "pnpm@12.21.0",
  "type": "module",
  "description": "Open-source, self-hostable business management platform for independent freelancers",
  "homepage": "https://github.com/ItsLhuis/remit#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ItsLhuis/remit.git"
  },
  "bugs": {
    "url": "https://github.com/ItsLhuis/remit/issues"
  },
  "license": "MIT",
  "author": "ItsLhuis",
  "keywords": [
    "business-management",
    "freelancers",
    "invoicing",
    "self-hosted",
    "nextjs",
    "react",
    "typescript",
    "postgresql",
    "drizzle",
    "better-auth"
  ],
  "scripts": {
    "prepare": "husky",
    "dev": "pnpm --filter @remit/web dev",
    "build": "pnpm --filter @remit/web build && pnpm --filter @remit/worker build",
    "build:scripts": "pnpm --filter @remit/web build:scripts",
    "build:source-maps": "pnpm --filter @remit/web build:source-maps",
    "start": "pnpm --filter @remit/web start",
    "dev:worker": "pnpm --filter @remit/worker dev",
    "start:worker": "pnpm --filter @remit/worker start",
    "check": "pnpm lint && pnpm typecheck && pnpm test",
    "ci": "pnpm lint && pnpm typecheck && pnpm test && pnpm build",
    "dev:setup": "pnpm services:up && pnpm database:migrate",
    "services:up": "docker compose -f docker-compose.dev.yml up -d",
    "services:down": "docker compose -f docker-compose.dev.yml down",
    "services:logs": "docker compose -f docker-compose.dev.yml logs -f",
    "services:restart": "docker compose -f docker-compose.dev.yml restart",
    "lint": "pnpm lint:cycles && eslint . --cache --cache-location node_modules/.cache/eslint/ --cache-strategy content",
    "lint:cycles": "oxlint",
    "lint:fix": "pnpm lint:cycles && eslint . --fix --cache --cache-location node_modules/.cache/eslint/ --cache-strategy content",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit && tsc --noEmit --project apps/web && tsc --noEmit --project apps/worker && tsc --noEmit --project packages/core",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:integration": "pnpm --filter @remit/web test:integration && pnpm --filter @remit/worker test:integration",
    "test:e2e": "pnpm --filter @remit/web test:e2e",
    "test:e2e:ui": "pnpm --filter @remit/web test:e2e:ui",
    "database:generate": "pnpm --filter @remit/web database:generate",
    "database:migrate": "pnpm --filter @remit/web database:migrate",
    "database:studio": "pnpm --filter @remit/web database:studio",
    "database:test:up": "docker compose -f docker-compose.test.yml up -d",
    "database:test:down": "docker compose -f docker-compose.test.yml down -v",
    "database:test:migrate": "pnpm --filter @remit/web database:test:migrate",
    "remit:backup": "pnpm --filter @remit/web remit:backup",
    "remit:reset-data": "pnpm --filter @remit/web remit:reset-data",
    "remit:reset-password": "pnpm --filter @remit/web remit:reset-password",
    "remit:restore": "pnpm --filter @remit/web remit:restore",
    "remit:rotate-encryption-key": "pnpm --filter @remit/web remit:rotate-encryption-key",
    "remit:seed-demo": "pnpm --filter @remit/web remit:seed-demo",
    "changelog:check": "tsx ./scripts/check-changelog.ts",
    "version:patch": "tsx ./scripts/bump-version.ts patch",
    "version:minor": "tsx ./scripts/bump-version.ts minor",
    "version:major": "tsx ./scripts/bump-version.ts major"
  },
  "engines": {
    "node": ">=26.13.1 <27",
    "pnpm": ">=12.21.0 <13"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": ">=26.13.1 <27",
      "onFail": "error"
    },
    "packageManager": {
      "name": "pnpm",
      "version": "12.21.0",
      "onFail": "error"
    }
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@types/node": "^26.6.6",
    "@vitest/coverage-v8": "^5.1.0",
    "chalk": "^6.0.1",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.4.6",
    "eslint-plugin-i18next": "^6.1.5",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-perfectionist": "^5.14.0",
    "eslint-plugin-sonarjs": "^4.2.2",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.1",
    "oxlint": "^1.94.0",
    "prettier": "^3.10.1",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.73.0",
    "vitest": "^5.1.0"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx,mjs,cjs}": [
      "eslint --fix --cache --cache-location node_modules/.cache/eslint/ --cache-strategy content",
      "prettier --write"
    ],
    "*.{json,css,md,yaml,yml}": [
      "prettier --write"
    ]
  }
}
