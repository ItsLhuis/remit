{
  "permissions": {
    "allow": [
      "Bash(pnpm *)",
      "Bash(git status)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git add *)",
      "Bash(git commit *)"
    ],
    "deny": [
      "Bash(rm -rf *)",
      "Bash(git push *)",
      "Bash(git reset *)",
      "Bash(git checkout *)",
      "Bash(git switch *)",
      "Bash(git restore *)",
      "Bash(git clean *)",
      "Bash(git stash *)",
      "Bash(git merge *)",
      "Bash(git rebase *)",
      "Bash(git cherry-pick *)",
      "Bash(git tag *)",
      "Bash(git worktree *)",
      "Bash(git branch -D *)",
      "Bash(git branch -d *)",
      "Bash(git branch -m *)",
      "Bash(git branch -M *)",
      "Bash(git branch -c *)",
      "Bash(git add -A*)",
      "Bash(git add --all*)",
      "Bash(git add -u*)",
      "Bash(git add --update*)",
      "Bash(git add .)",
      "Bash(git add . *)",
      "Bash(git add :/*)",
      "Bash(git commit --amend*)",
      "Bash(git commit * --amend*)",
      "Bash(git commit --no-verify*)",
      "Bash(git commit * --no-verify*)",
      "Bash(git commit -n*)",
      "Bash(git commit * -n *)",
      "Bash(git -c core.hooksPath*)",
      "Bash(git config core.hooksPath*)",
      "Bash(HUSKY=0 *)",
      "PowerShell(rm -rf *)",
      "PowerShell(git push *)",
      "PowerShell(git reset *)",
      "PowerShell(git checkout *)",
      "PowerShell(git switch *)",
      "PowerShell(git restore *)",
      "PowerShell(git clean *)",
      "PowerShell(git stash *)",
      "PowerShell(git merge *)",
      "PowerShell(git rebase *)",
      "PowerShell(git cherry-pick *)",
      "PowerShell(git tag *)",
      "PowerShell(git worktree *)",
      "PowerShell(git branch -D *)",
      "PowerShell(git branch -d *)",
      "PowerShell(git branch -m *)",
      "PowerShell(git branch -M *)",
      "PowerShell(git branch -c *)",
      "PowerShell(git add -A*)",
      "PowerShell(git add --all*)",
      "PowerShell(git add -u*)",
      "PowerShell(git add --update*)",
      "PowerShell(git add .)",
      "PowerShell(git add . *)",
      "PowerShell(git add :/*)",
      "PowerShell(git commit --amend*)",
      "PowerShell(git commit * --amend*)",
      "PowerShell(git commit --no-verify*)",
      "PowerShell(git commit * --no-verify*)",
      "PowerShell(git commit -n*)",
      "PowerShell(git commit * -n *)",
      "PowerShell(git -c core.hooksPath*)",
      "PowerShell(git config core.hooksPath*)",
      "PowerShell(HUSKY=0 *)",
      "Read(.env)",
      "Read(.env.local)",
      "Read(.env.production)",
      "Read(.env.development)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/git-guard.mjs\""
          }
        ]
      }
    ]
  }
}
