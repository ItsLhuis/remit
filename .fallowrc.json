{
  "$schema": "https://raw.githubusercontent.com/fallow-rs/fallow/main/schema.json",
  "entry": [
    "apps/web/scripts/*.ts",
    "apps/worker/worker.ts",
    "apps/worker/resolveWebDependencies.ts",
    "apps/web/instrumentation.ts",
    "apps/web/features/*/index.ts",
    "apps/web/features/*/server.ts",
    "apps/web/lib/*/index.ts",
    "packages/core/index.ts"
  ],
  "ignorePatterns": [
    "apps/web/database/schema/**",
    "apps/web/scripts/dist/**",
    "apps/worker/dist/**",
    "**/*.generated.ts",
    "apps/web/doctor.config.ts"
  ],
  "ignoreDependencies": ["pino-pretty", "postcss-load-config", "intl-messageformat"],
  "dynamicallyLoaded": [
    "apps/web/lib/storage/s3.ts",
    "apps/web/lib/jobs/worker.ts",
    "apps/web/features/invoices/jobs.ts",
    "apps/web/features/recurringInvoices/jobs.ts",
    "apps/web/features/dataExport/jobs.ts",
    "apps/web/features/reports/jobs.ts",
    "apps/web/features/activityLog/events/index.ts",
    "apps/web/features/proposals/jobs.ts",
    "apps/web/features/creditNotes/jobs.ts",
    "apps/web/features/contracts/jobs.ts",
    "apps/web/features/trash/jobs.ts",
    "apps/web/features/backups/jobs.ts",
    "apps/web/features/webhooks/jobs.ts",
    "apps/web/features/webhooks/events.ts"
  ],
  "rules": {
    "unused-exports": "warn",
    "unused-types": "warn"
  },
  "duplicates": {
    "ignore": ["**/__tests__/**", "**/*.test.ts", "**/*.test.tsx", "apps/web/tests/**"]
  }
}
