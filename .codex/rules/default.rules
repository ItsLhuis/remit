# Codex command policy for this repository.
# Valid Codex rules use Starlark-style prefix_rule(...) calls.

prefix_rule(
    pattern = ["pnpm", "add"],
    decision = "prompt",
    justification = "Dependency installation can change lockfiles and may require network access.",
)

prefix_rule(
    pattern = ["pnpm", "install"],
    decision = "prompt",
    justification = "Dependency installation can change lockfiles and may require network access.",
)

prefix_rule(
    pattern = ["docker", "compose"],
    decision = "prompt",
    justification = "Docker commands can start services, mutate volumes, or affect local databases.",
)

prefix_rule(
    pattern = ["docker-compose"],
    decision = "prompt",
    justification = "Docker commands can start services, mutate volumes, or affect local databases.",
)

prefix_rule(
    pattern = ["pnpm", "database:generate"],
    decision = "prompt",
    justification = "Database migration generation must be reviewed.",
)

prefix_rule(
    pattern = ["pnpm", "database:migrate"],
    decision = "prompt",
    justification = "Database migrations can change schema/data and must be reviewed.",
)

prefix_rule(
    pattern = ["pnpm", "database:studio"],
    decision = "prompt",
    justification = "Database studio can expose or mutate local data.",
)

prefix_rule(
    pattern = ["git", "commit"],
    decision = "prompt",
    justification = "Creating commits changes repository history and requires explicit user intent.",
)

prefix_rule(
    pattern = ["rm", "-rf", "/"],
    decision = "forbidden",
    justification = "Filesystem-wide deletion is destructive.",
)

prefix_rule(
    pattern = ["rm", "-rf", "/*"],
    decision = "forbidden",
    justification = "Filesystem-wide deletion is destructive.",
)

prefix_rule(
    pattern = ["printenv"],
    decision = "prompt",
    justification = "Environment variables may contain secrets.",
)

prefix_rule(
    pattern = ["env"],
    decision = "prompt",
    justification = "Environment variables may contain secrets.",
)

prefix_rule(
    pattern = ["Get-ChildItem", "Env:"],
    decision = "prompt",
    justification = "Environment variables may contain secrets.",
)

prefix_rule(
    pattern = ["git", "push"],
    decision = "forbidden",
    justification = "The owner reviews local commits and performs every push (AGENTS.md, Owner decisions).",
)

prefix_rule(
    pattern = ["git", ["reset", "checkout", "switch", "restore", "clean", "stash"]],
    decision = "forbidden",
    justification = "Can discard or move local work; agents never run it (AGENTS.md, Owner decisions).",
)

prefix_rule(
    pattern = ["git", ["merge", "rebase", "cherry-pick", "tag", "worktree"]],
    decision = "forbidden",
    justification = "History, branch and worktree operations belong to the owner (AGENTS.md, Owner decisions).",
)

prefix_rule(
    pattern = ["git", "branch", ["-D", "-d", "-m", "-M", "-c"]],
    decision = "forbidden",
    justification = "Branch changes belong to the owner (AGENTS.md, Owner decisions).",
)

prefix_rule(
    pattern = ["git", "add", ["-A", "--all", "-u", "--update", ".", ":/"]],
    decision = "forbidden",
    justification = "Agents stage explicit paths only (.agents/skills/git-commit/SKILL.md).",
)

prefix_rule(
    pattern = ["git", "commit", ["--amend", "--no-verify", "-n"]],
    decision = "forbidden",
    justification = "Agents never amend or bypass hooks (.agents/skills/git-commit/SKILL.md).",
)
