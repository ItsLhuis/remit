# `bash scripts/host/install.sh` writes `.env` for a Docker Compose install, with every secret
# generated. Copy this file by hand only for local development or a manual install
# (docs/operations/INSTALL.md).

# ─── Public address ──────────────────────────────────────────────────────────
# The origin browsers reach the instance at: scheme and host, a port only when it is not the
# default, and no path or trailing slash. Every link Remit sends is built from it.
# Development: http://localhost:3000
# Production:  https://remit.example.com
REMIT_PUBLIC_URL=http://localhost:3000

# ─── Database ────────────────────────────────────────────────────────────────
POSTGRES_USER=remit
POSTGRES_PASSWORD=remit
POSTGRES_DB=remit

# Full connection string used by Drizzle and by the app when it runs outside Docker.
# Development: postgresql://remit:remit@localhost:5432/remit
# Docker Compose builds its own from the three values above and ignores this one.
DATABASE_URL=postgresql://remit:remit@localhost:5432/remit

# ─── Better Auth ─────────────────────────────────────────────────────────────
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=

# Master key for AES-256-GCM encryption at rest. It also encrypts every backup archive, so losing it
# loses the encrypted columns and every backup. Keep a copy somewhere other than this server.
# Generate with: openssl rand -base64 32
REMIT_ENCRYPTION_KEY=

# ─── App ─────────────────────────────────────────────────────────────────────
# Port the app is published on by docker-compose.yml (default: 3000)
PORT=3000

# Interface that port is published on (default: 0.0.0.0). 127.0.0.1 when a proxy on the same host
# fronts the app, so it is not also reachable around the proxy.
REMIT_APP_BIND=0.0.0.0

# Image tag docker-compose.yml runs for remit/app and remit/worker (default: latest)
REMIT_IMAGE_TAG=latest

# Set to "true" or "1" to enable hosted/SaaS mode (default: false)
REMIT_HOSTED_MODE=false

# Persistent data volume used for local backups and health checks
REMIT_DATA_DIR=./data

NODE_ENV=development

# ─── Reverse proxy (optional) ────────────────────────────────────────────────
# Uncomment to run Caddy in front of the app with automatic HTTPS. REMIT_PUBLIC_URL must then be an
# https:// origin with no port, ports 80 and 443 must be free, and REMIT_APP_BIND should be 127.0.0.1.
# COMPOSE_PROFILES=with-proxy

# Email for the ACME account Caddy obtains the certificate with. Required with the profile above.
REMIT_ACME_EMAIL=

# ─── Redis ───────────────────────────────────────────────────────────────────
# Connection string for the BullMQ job queue and worker (ADR-0023) and the rate-limit counters
# (ADR-0037)
# Host/dev app outside Docker: redis://localhost:6379
# Docker Compose app runtime: leave unset; docker-compose.yml defaults to redis://redis:6379
REDIS_URL=redis://localhost:6379

# Port exposed by Redis in development (default: 6379)
REDIS_PORT=6379

# ─── MinIO / S3-compatible storage ───────────────────────────────────────────
MINIO_ROOT_USER=remit
MINIO_ROOT_PASSWORD=

# S3 API endpoint used by server-side code. Browsers never reach it: uploads and public files go
# through the app (ADR-0040), so this is an internal address.
# Host/dev app outside Docker: uncomment and use http://localhost:9000.
# Docker Compose app runtime: leave unset; docker-compose.yml defaults to http://minio:9000.
# MINIO_ENDPOINT=http://localhost:9000

MINIO_BUCKET=remit

# Ports MinIO is published on in development only (defaults: 9000 API, 9001 console). The
# production docker-compose.yml publishes neither.
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001

# ─── PDF rendering ───────────────────────────────────────────────────────────

# Path to the Chromium executable the worker prints document PDFs with (ADR-0022).
# Only the worker image ships Chromium, so this is unset for the web application and set by the
# worker container. Set it by hand only when running `pnpm dev:worker` on the host.
# Worker container (docker-compose.yml sets this for you): /usr/bin/chromium-browser
# macOS host: /Applications/Google Chrome.app/Contents/MacOS/Google Chrome
# Windows host: C:\Program Files\Google\Chrome\Application\chrome.exe
# REMIT_CHROMIUM_PATH=/usr/bin/chromium-browser

# ─── Observability ───────────────────────────────────────────────────────────
# Sentry DSN for error tracking (optional)
SENTRY_DSN=

# ─── Metrics ─────────────────────────────────────────────────────────────────
# Bearer token that protects GET /api/metrics (optional - leave empty to disable metrics)
# Empty: the endpoint answers 404 to everyone. Set: a scraper must send "Authorization: Bearer <token>".
# Generate with: openssl rand -base64 32
REMIT_METRICS_TOKEN=

# ─── Webhooks ────────────────────────────────────────────────────────────────
# Hostnames outbound webhooks may reach at a private address or over plain HTTP (optional, comma-separated)
# Empty: every webhook must be HTTPS to a public address. Example: n8n.lan,automation.internal
REMIT_WEBHOOK_ALLOWED_HOSTS=
