# ─── Database ────────────────────────────────────────────────────────────────
POSTGRES_USER=remit
POSTGRES_PASSWORD=remit
POSTGRES_DB=remit

# Full connection string used by Drizzle and the app
# Development: postgresql://remit:remit@localhost:5432/remit
# Production:  postgresql://remit:<password>@database:5432/remit  (docker-compose builds this automatically)
DATABASE_URL=postgresql://remit:remit@localhost:5432/remit

# ─── Better Auth ─────────────────────────────────────────────────────────────
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=

# Master key for AES-256-GCM encryption at rest
# Generate with: openssl rand -base64 32
REMIT_ENCRYPTION_KEY=

# Full URL where the app runs - no trailing slash
# Dev:  http://localhost:3000
# Prod: https://yourdomain.com
BETTER_AUTH_URL=http://localhost:3000

# ─── App ─────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Port exposed by the production container (default: 3000)
PORT=3000

# Set to "true" or "1" to enable hosted/SaaS mode (default: false)
REMIT_HOSTED_MODE=false

# Persistent data volume used for local backups and health checks
REMIT_DATA_DIR=./data

NODE_ENV=development

# ─── MinIO / S3-compatible storage ───────────────────────────────────────────
MINIO_ROOT_USER=remit
MINIO_ROOT_PASSWORD=

# Internal S3 API endpoint used by server-side code.
# Host/dev app outside Docker: uncomment and use http://localhost:9000.
# Docker Compose app runtime: leave unset; docker-compose.yml defaults to http://minio:9000.
# MINIO_ENDPOINT=http://localhost:9000

MINIO_BUCKET=remit

# Browser-accessible S3 API origin used to sign presigned upload URLs.
# SigV4 signs the host, so this must be the exact origin the browser will PUT to.
# Do not use Docker-only hostnames like http://minio:9000 here unless browsers can reach them.
# Local Docker/host: http://localhost:9000
# Production: https://storage.example.com
# MINIO_PUBLIC_URL=http://localhost:9000

# Browser-accessible base URL for reading stored files.
# For MinIO path-style URLs, include the bucket path.
# Local Docker/host: http://localhost:9000/remit
# Production: https://storage.example.com/remit
NEXT_PUBLIC_STORAGE_BASE_URL=http://localhost:9000/remit

# Ports exposed by MinIO (defaults: 9000 API, 9001 console)
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001

# ─── Observability ───────────────────────────────────────────────────────────
# Sentry DSN for error tracking (optional)
SENTRY_DSN=

# ─── Metrics ─────────────────────────────────────────────────────────────────
# Bearer token that protects GET /api/metrics (optional - leave empty to disable metrics)
# Generate with: openssl rand -base64 32
REMIT_METRICS_TOKEN=
