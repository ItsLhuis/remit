{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["import"],
  "categories": {
    "correctness": "off",
    "suspicious": "off",
    "pedantic": "off",
    "style": "off",
    "restriction": "off",
    "nursery": "off",
    "perf": "off"
  },
  "rules": {
    "import/no-cycle": [
      "error",
      {
        "ignoreExternal": true,
        "ignoreTypes": true
      }
    ]
  },
  "ignorePatterns": [
    ".next/**",
    "coverage/**",
    "scripts/dist/**",
    "drizzle/**",
    "public/**",
    "next-env.d.ts"
  ]
}
