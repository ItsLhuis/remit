# Environment files hold real secrets and never enter history; only the *.example templates do.
# Husky runs this under `sh -e`, and grep and check-ignore exit 1 when nothing matches, so each
# capture ends in `|| true`.
secrets=$(git diff --cached --name-only --diff-filter=ACMR | grep -E '(^|/)\.env(\.[^/]*)?$' | grep -vE '\.example$' || true)

if [ -n "$secrets" ]; then
  echo "Refusing to commit environment files:" >&2
  echo "$secrets" >&2
  exit 1
fi

# A newly added file that .gitignore excludes was forced in with `git add -f`. Only additions are
# checked, so the few tracked files that predate an ignore rule can still be edited.
forced=$(git diff --cached --name-only --diff-filter=A | git check-ignore --no-index --stdin || true)

if [ -n "$forced" ]; then
  echo "Refusing to commit files that .gitignore excludes:" >&2
  echo "$forced" >&2
  exit 1
fi

pnpm lint-staged
pnpm lint:cycles
