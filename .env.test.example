# ─── Database ────────────────────────────────────────────────────────────────
POSTGRES_USER=remit_test
POSTGRES_PASSWORD=remit_test
POSTGRES_DB=remit_test

# Full connection string used by Drizzle integration tests.
# Matches docker-compose.test.yml, which exposes Postgres on localhost:5433.
DATABASE_URL=postgresql://remit_test:remit_test@localhost:5433/remit_test

# ─── Better Auth ─────────────────────────────────────────────────────────────
# Test-only secret. Do not reuse outside local/CI test runs.
BETTER_AUTH_SECRET=test-secret-for-integration-tests-not-real

# Master key for AES-256-GCM encryption at rest.
# This is 32 zero bytes encoded as base64 and is safe only for tests.
REMIT_ENCRYPTION_KEY=AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=

# Integration tests do not start the app server; these satisfy environment validation.
BETTER_AUTH_URL=http://localhost:3000

# ─── App ─────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000

PORT=3000

REMIT_HOSTED_MODE=false

NODE_ENV=test

# ─── MinIO (S3-compatible storage) ───────────────────────────────────────────
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin

# Stub values for environment validation in integration tests.
MINIO_ENDPOINT=http://localhost:9000
MINIO_BUCKET=remit-test
MINIO_PUBLIC_URL=http://localhost:9000/remit-test
NEXT_PUBLIC_STORAGE_BASE_URL=http://localhost:9000/remit-test

MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
